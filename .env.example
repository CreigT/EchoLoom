APP_NAME=EchoLoom
APP_ENV=development
APP_SECRET=change-me-to-a-long-random-secret
API_HOST=0.0.0.0
API_PORT=8000

# Auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/echoloom.db
VECTOR_STORE_PATH=./data/vector

# Agent / LLM adapters (optional — demo runs without keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=mock

# Audio providers (optional)
ELEVENLABS_API_KEY=
AUDIO_PROVIDER=mock

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Security
PII_REDACTION_ENABLED=true
ENCRYPTION_KEY=
MAX_UPLOAD_MB=50
